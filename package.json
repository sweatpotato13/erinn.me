{
  "name": "erinn.me",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "scripts": {
    "data:collect": "pnpm exec tsx scripts/collect-reference-data.ts",
    "data:check": "pnpm exec tsx scripts/check-reference-data.ts && pnpm exec tsx scripts/check-item-reference.ts && pnpm exec tsx scripts/check-enchant-reference.ts && pnpm exec tsx scripts/build-reforge-reference.ts --check && pnpm exec tsx scripts/build-echostone-reference.ts --check && pnpm exec tsx scripts/build-miniature-reference.ts --check && pnpm exec tsx scripts/build-totem-reference.ts --check && pnpm exec tsx scripts/check-barter-season.ts && pnpm catalog:validate && pnpm exec tsx scripts/build-barter-reference.ts --check && pnpm exec tsx scripts/build-crafting-reference.ts --check && pnpm exec tsx scripts/build-murias-reference.ts --check && pnpm exec tsx scripts/build-auction-filter-reference.ts --check && pnpm exec tsx scripts/build-ogham-reference.ts --check",
    "data:expiry": "pnpm exec tsx scripts/check-data-expiry.ts",
    "items:build": "pnpm exec tsx scripts/build-suggest-index.ts && pnpm exec tsx scripts/build-item-id-map.ts",
    "catalog:collect": "pnpm exec tsx scripts/collect-auction-item-candidates.ts",
    "catalog:validate": "pnpm exec tsx scripts/validate-auction-item-catalog.ts",
    "prebuild": "pnpm catalog:validate && pnpm items:build && pnpm enchants:build && pnpm reforge:build && pnpm echostone:build && pnpm miniatures:build && pnpm totems:build && pnpm barter:build && pnpm crafting:build && pnpm murias:build && pnpm auction-filters:build && pnpm ogham:build",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint \"{src,e2e,scripts}/**/*.{ts,tsx}\"",
    "lint:fix": "pnpm lint --fix",
    "typecheck": "tsc --noEmit",
    "prettier": "prettier --write \"src/**/*.{ts,tsx}\"",
    "prepare": "husky",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "enchants:build": "pnpm exec tsx scripts/build-enchant-index.ts",
    "reforge:build": "pnpm exec tsx scripts/build-reforge-reference.ts",
    "echostone:build": "pnpm exec tsx scripts/build-echostone-reference.ts",
    "miniatures:build": "pnpm exec tsx scripts/build-miniature-reference.ts",
    "totems:build": "pnpm exec tsx scripts/build-totem-reference.ts",
    "barter:build": "pnpm exec tsx scripts/build-barter-reference.ts",
    "barter:icons:collect": "pnpm exec tsx scripts/collect-barter-icons.ts",
    "barter:refresh": "pnpm barter:season:collect && pnpm barter:build && pnpm barter:icons:collect",
    "barter:season:collect": "pnpm exec tsx scripts/collect-barter-season.ts",
    "crafting:build": "pnpm exec tsx scripts/build-crafting-reference.ts",
    "murias:build": "pnpm exec tsx scripts/build-murias-reference.ts",
    "auction-filters:build": "pnpm exec tsx scripts/build-auction-filter-reference.ts",
    "ogham:build": "pnpm exec tsx scripts/build-ogham-reference.ts"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-query-devtools": "^5.104.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/firewall": "^1.2.6",
    "@vercel/speed-insights": "^2.0.0",
    "dotenv": "^18.0.7",
    "lucide-react": "^1.55.0",
    "next": "^16.4.0",
    "nodemailer": "^10.1.0",
    "postcss": "^8.5.29",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "use-sound": "^5.0.0",
    "yup": "^1.7.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/eslint-plugin-security": "^3.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "daisyui": "^5.7.47",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
